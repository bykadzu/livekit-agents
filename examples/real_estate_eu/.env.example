# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# LLM Provider (OpenAI-compatible)
OPENAI_API_KEY=your_openai_api_key

# Speech-to-Text (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Text-to-Speech (choose one or both)
# ElevenLabs (recommended for EU voices)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Cartesia (alternative)
CARTESIA_API_KEY=your_cartesia_api_key

# Silero VAD (Voice Activity Detection) - usually no key needed
# Silero runs locally

# EU MLS/Property APIs (integrate with your preferred providers)
# UK
RIGHTMOVE_API_KEY=your_rightmove_key
ZOOPLA_API_KEY=your_zoopla_key

# Spain
IDEALISTA_API_KEY=your_idealista_key

# France
SELOGER_API_KEY=your_seloger_key

# Germany
IMMOBILIENSCOUT24_API_KEY=your_immoscout_key

# Booking Integration
CALENDLY_API_KEY=your_calendly_api_key
GOOGLE_CALENDAR_API_KEY=your_google_calendar_key

# Webhook/CRM Integration
# This URL will receive lead notifications, booking confirmations, etc.
# Can be n8n, Zapier, Make.com, or custom endpoint
DEFAULT_WEBHOOK_URL=https://your-n8n.com/webhook/real-estate-leads

# Email Marketing (for drip campaigns)
MAILCHIMP_API_KEY=your_mailchimp_key
SENDGRID_API_KEY=your_sendgrid_key

# Analytics (optional)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# Logging
LOG_LEVEL=INFO
