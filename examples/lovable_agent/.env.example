# LiveKit Connection
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Core AI Providers
OPENAI_API_KEY=your-openai-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key

# Avatar Provider (choose one)
# Options: simli, tavus, hedra, bithuman, anam, bey
# Leave empty for voice-only mode
AVATAR_PROVIDER=

# ===== Simli Avatar Configuration =====
# Get your API key from: https://simli.com
SIMLI_API_KEY=
SIMLI_AVATAR_ID=
# Optional: customize avatar face and voice
# SIMLI_FACE_ID=
# SIMLI_VOICE_ID=

# ===== Tavus Avatar Configuration =====
# Get your API key from: https://tavus.io
TAVUS_API_KEY=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=

# ===== Hedra Avatar Configuration =====
# Get your API key from: https://hedra.com
HEDRA_API_KEY=
# Path to avatar image file (local or URL)
HEDRA_AVATAR_IMAGE=

# ===== BitHuman Avatar Configuration =====
# Get your API key from: https://bithuman.ai
BITHUMAN_API_KEY=
# Use either avatar_id or image_url
BITHUMAN_AVATAR_ID=
# BITHUMAN_IMAGE_URL=

# ===== Anam Avatar Configuration =====
# Get your API key from: https://anam.ai
ANAM_API_KEY=
ANAM_PERSONA_ID=

# ===== Bey Avatar Configuration =====
# Get your API key from: https://bey.ai
BEY_API_KEY=
BEY_AVATAR_ID=
